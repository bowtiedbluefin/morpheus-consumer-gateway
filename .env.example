# HTTPS deployment: set all four values, then use --profile https.
DOMAIN=ai.example.com
PUBLIC_ORIGIN=https://ai.example.com
COOKIE_SECURE=true
ETH_NODE_ADDRESS=https://YOUR-BASE-RPC-ENDPOINT
# Base mainnet. For Base Sepolia, use 84532 and its RPC endpoint.
ETH_NODE_CHAIN_ID=8453
NODE_IMAGE=ghcr.io/morpheusais/morpheus-lumerin-node:v7.11.0@sha256:3b2b1dea272124ce3c71ab35132f5f8a6dad54bb1e59614a50401a76c062a2b1

# Local HTTP instead: PUBLIC_ORIGIN=http://localhost:8000, COOKIE_SECURE=false.
# Port 8000 binds only to loopback. Node port 8082 is never published.
